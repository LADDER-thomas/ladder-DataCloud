      "前回発送予定日",
      "前回配送予定日",
      "モール注文日時",
      "注文取込日時",
      "出荷依頼日時",
      "注文作成時刻",
      "注文の支払い日時",
      "発送準備完了日時",
      "発送日時",
      "配達日時",
      "受送信時刻",
      "キャンセル日",
      "削除日",
      "初回督促日",
      "最終督促日",
      "支払期限",
      "仮売上日",
      "実売上日",
      "入金日",
      "取消日",
      "キャンセル日時",
      "返信開始時刻",
      "返信時刻",
      "承認依頼時刻",
      "承認時刻"
