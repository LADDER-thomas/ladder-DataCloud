      "sf_fields": ["ord.ecf_payment_total__c", "ord.ecf_total__c"],
      "reism_names": ["Order_payment_total", "Order_total"],
      "review": "confirmed_candidates"
    },
    {
      "column": "合計",
      "sf_fields": ["ord.ecf_total__c"],
      "note": "build は支払い合計優先のためフォールバック列",
      "review": "confirmed"
    },
    {
      "column": "支払い方法",
      "sf_fields": ["ord.ecf_payment_method_name__c", "ord.reismobj__PaymentMethod__c"],
      "reism_names": ["Order_payment_method_name"],
      "review": "confirmed"
    },
    {
      "column": "受注種別",
      "sf_fields": ["ord.ecf_order_kind__c"],
      "reism_names": ["Order_order_kind"],
      "review": "tbd"
    },
    {
      "column": "対応状況",
      "sf_fields": ["ord.ecf_order_human_state__c", "ord.ecf_order_state__c"],
      "reism_names": ["Order_human_state", "Order_state"],
      "review": "confirmed_candidates"
    },
    {
      "column": "送料",
      "sf_fields": ["ord.ecf_deliv_fee__c", "ord.reismobj__base_shipping_fee__c"],
      "review": "tbd"
    },
    {
      "column": "決済状況",
      "sf_fields": ["ord.ecf_payment_human_state__c", "ord.ecf_pay_human_state__c"],
      "review": "tbd"
    },
    {
      "column": "取消日",
      "sf_fields": ["ord.ecf_canceled_at__c"],
      "reism_names": ["Order_canceled_at"],
      "review": "confirmed"
    },
    {
      "column": "購入商品（商品コード）",
      "sf_fields": ["li.ecf_product_number__c", "li.reismobj__CatalogItemId__c"],
      "join_step": "order_line",
      "reism_names": ["OrderItem_product_number"],
      "review": "confirmed"
    },
    {
      "column": "購入商品（SKUコード）",
      "sf_fields": ["li.ecf_sku__c", "li.ecf_variant_sku__c", "ci.reismobj__StockKeepingUnit__c"],
      "join_step": "order_line+catalog_item",
      "note": "ecf_sku__c 優先。無い場合は ecf_variant_sku__c または CatalogItem の SKU",
      "reism_names": ["OrderItem_variant_sku"],
      "review": "confirmed_ecf_sku_primary"
    },
    {
      "column": "購入商品（商品名）",
      "sf_fields": ["li.ecf_product_name__c", "li.ecf_name__c", "li.CatelogItemText__c"],
      "join_step": "order_line",
      "reism_names": ["OrderItem_product_name"],
      "review": "confirmed_candidates"
    },
    {
      "column": "購入商品（単価）",
      "sf_fields": ["li.ecf_sales_price__c", "li.ecf_price__c", "li.reismobj__UnitPrice__c"],
      "join_step": "order_line",
      "review": "tbd"
    },
    {
      "column": "購入商品（個数）",
      "sf_fields": ["li.ecf_quantity__c", "li.reismobj__Quantity__c"],
      "join_step": "order_line",
      "review": "confirmed"
    },
    {
      "column": "購入商品（商品カテゴリー）",
      "sf_fields": ["li.ecf_product_category_names__c"],
      "join_step": "order_line",
      "reism_names": ["OrderItem_product_category_names"],
      "review": "confirmed"
    },
    {
      "column": "購入商品（原価）",
      "sf_fields": ["li.ecf_list_price__c"],
      "join_step": "order_line",
      "review": "tbd"
    },
    {
      "column": "購入URL",
      "sf_fields": ["ord.ecf_url__c"],
      "reism_names": ["Order_url"],
      "review": "confirmed"
    },
    {
      "column": "広告URLグループ名",
      "sf_fields": ["ord.ecf_url_group__c"],
      "reism_names": ["Order_url_group"],
      "review": "confirmed"
    },
    {
      "column": "媒体",
      "sf_fields": ["ord.ecf_store__c", "ord.ecf_cv_route__c"],
      "reism_names": ["Order_store"],
      "review": "business_semantics"
    },
    {
      "column": "クーポン",
      "sf_fields": ["ord.ecf_coupon_codes__c"],
      "reism_names": ["Order_coupon_codes"],
      "review": "confirmed"
    },
    {
      "column": "デバイス",
      "sf_fields": ["ord.ecf_device_variant__c"],
      "reism_names": ["Order_device_variant"],
      "review": "confirmed"
    },
    {
