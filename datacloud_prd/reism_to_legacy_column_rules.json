  "salesforce_source": {
    "setup_org_url": "https://enterprise-agility-9382--agentforce.sandbox.my.salesforce-setup.com/",
    "note": "prd-appflow バケットの NDJSON は上記 Salesforce 本番組織上のオブジェクトを Amazon AppFlow 等でオブジェクト単位エクスポートしたもの。オブジェクト定義・項目・主従関係の正は Setup のオブジェクト管理で確認する。"
  },
  "object_relationships": [
    {
      "child_api": "reismobj__OrderItem__c",
      "lookup_field": "reismobj__OrderId__c",
      "parent_api": "reismobj__Order__c",
      "parent_key": "Id",
      "cardinality": "N:1",
      "role": "受注明細行は注文ヘッダに属する"
    },
    {
      "child_api": "reismobj__Order__c",
      "lookup_field": "reismobj__Account__c",
      "parent_api": "Account",
      "parent_key": "Id",
      "cardinality": "N:1",
      "role": "注文は顧客（Account）に紐づく。性別・生年月日・会員ランク等の取得元"
    },
    {
      "child_api": "reismobj__OrderItem__c",
      "lookup_field": "reismobj__CatalogItemId__c",
      "parent_api": "reismobj__CatalogItem__c",
      "parent_key": "Id",
      "cardinality": "N:1",
      "role": "明細行はカタログ商品マスタに紐づく。SKU 補完・商品名補完に使用"
    },
    {
      "child_api": "reismobj__DistributionPrice__c",
      "lookup_field": "reismobj__CatalogItem__c",
      "parent_api": "reismobj__CatalogItem__c",
      "parent_key": "Id",
      "cardinality": "N:1",
      "cardinality_note": "同一 CatalogItem に対し複数 Distribution の価格行があり得る。ETL では CatalogItem 単位で最新 1 行に圧縮",
      "role": "流通チャネル別価格。原価・単価の補助"
    },
