{
  "schema_version": 1,
  "_description": "prd-appflow NDJSON を OrderItem→Order→Account→CatalogItem→DistributionPrice まで結合し、本店受注・定期（jukkan/teiki 論理列）へ寄せる。reism 名は ladder_reism_mapping.csv の Name 列と対応。",
  "business_decisions": {
    "受注番号": "ord.reismobj__OrderNumber__c（表示用番号）",
    "受注日": "ord.ecf_order_completed_at__c",
    "account_join": "性別・生年月日・会員ランク名（および LINE ID）は Account から取得",
    "定期ブランド絞り": "OrderItem の ecf_sku__c を主とし、無ければ ecf_variant_sku__c",
    "全ジョイン": "Account / Order / OrderItem / CatalogItem / DistributionPrice をすべて結合（DistributionPrice は CatalogItem キーで左結合し、同一 CatalogItem に複数行ある場合は LastModifiedDate が最新の 1 行に圧縮）",
    "定期の範囲": "本店（EC / Order）のみ。モール・TikTok は定期 04 向けソースとしない"
  },
  "joins": {
    "jukkan_order_line": {
      "grain": "1 行 = 受注明細 1 行",
      "order": {
        "appflow_prefix": "la-sand-reismobj__Order__c/",
        "alias": "ord"
      },
      "order_item": {
        "appflow_prefix": "la-sand-reismobj__OrderItem__c/",
        "alias": "li",
        "join_on": [
          "li.reismobj__OrderId__c = ord.Id"
        ]
      },
      "account": {
        "appflow_prefix": "la-sand-Account/",
        "alias": "acc",
        "join_on": [
          "ord.reismobj__Account__c = acc.Id"
        ],
        "how": "left"
      },
      "catalog_item": {
        "appflow_prefix": "la-sand-reismobj__CatalogItem__c/",
        "alias": "ci",
        "join_on": [
          "li.reismobj__CatalogItemId__c = ci.Id"
        ],
        "how": "left"
      },
      "distribution_price": {
        "appflow_prefix": "la-sand-reismobj__DistributionPrice__c/",
        "alias": "dp",
        "join_on": [
          "dp.reismobj__CatalogItem__c = ci.Id",
          "（任意）ord.reismobj__DistributionId__c = dp.reismobj__Distribution__c が両方非空のときは併用"
        ],
        "how": "left",
        "dedupe": "reismobj__CatalogItem__c 単位で LastModifiedDate 最大の 1 行"
      }
    },
    "teiki_from_order": {
      "grain": "1 行 = 定期契約（Order からの論理 1 行）。SubsOrder オブジェクトの AppFlow が無い場合の代替",
      "source": "order_header",
      "key_columns": [
        "ecf_subs_order_number__c",
        "ecf_subsorder_id__c"
      ],
      "filter": "ecf_subs_order_number__c または ecf_subsorder_id__c が非空の Order のみ",
      "dedupe": "顧客番号 + 定期キーで最新（LastModifiedDate または ecf_subsorder_updated_at__c）を 1 行に"
    },
    "teiki_from_subsorder": {
      "grain": "SubsOrder__c 相当のエクスポートがある場合はこちらを優先（将来）",
      "appflow_prefix": "TBD",
      "note": "現状 prd-appflow には SubsOrder プレフィックス無し。追加されたら jukkan_teiki_source を切替"
    }
  },
  "jukkan": [
    {
      "column": "顧客番号",
      "sf_fields": ["ord.ecf_customer_number__c"],
      "fallback_sf": ["ord.ecf_number__c"],
      "reism_names": ["Order_customer_number"],
      "review": "confirmed"
    },
    {
      "column": "メールアドレス",
      "sf_fields": ["ord.ecf_customer_email__c", "ord.ecf_email__c"],
      "reism_names": ["Order_customer_id", "Order_email"],
      "review": "confirmed"
    },
    {
      "column": "性別",
      "sf_fields": ["acc.ecf_sex__c"],
      "reism_names": ["Customer_sex"],
      "requires": ["account"],
      "review": "confirmed_account"
    },
    {
      "column": "生年月日",
      "sf_fields": ["acc.ecf_birth__c"],
      "reism_names": ["Customer_birth"],
      "requires": ["account"],
      "review": "confirmed_account"
    },
    {
      "column": "会員ランク名",
      "sf_fields": ["acc.ecf_customer_rank_name__c"],
      "reism_names": ["Customer_customer_rank_name"],
      "requires": ["account"],
      "review": "confirmed_account"
    },
    {
      "column": "LINE ID",
      "sf_fields": ["acc.ecf_line_id__c"],
      "reism_names": ["Customer_line_id"],
      "requires": ["account"],
      "review": "confirmed_account"
    },
    {
      "column": "更新日",
      "sf_fields": ["ord.ecf_order_updated_at__c", "ord.LastModifiedDate"],
      "reism_names": ["Order_updated_at"],
      "review": "tbd_mapping_name"
    },
    {
      "column": "顧客購入回数",
      "sf_fields": ["acc.ecf_orders_count__c", "ord.ecf_orders_count__c"],
      "reism_names": ["Customer_buy_times", "SubsOrder_orders_count"],
      "review": "prefer_account"
    },
    {
      "column": "顧客タイプ名",
      "sf_fields": ["acc.ecf_customer_type_name__c"],
      "reism_names": ["Customer_customer_type_name"],
      "requires": ["account"],
      "review": "confirmed_account"
    },
    {
      "column": "顧客ID",
      "sf_fields": ["ord.ecf_customer_id__c", "acc.ecf_customer_id__c"],
      "reism_names": ["Order_customer_id"],
      "review": "confirmed"
    },
    {
      "column": "請求先（都道府県）",
      "sf_fields": ["ord.reismobj__BillingState__c", "ord.ecf_prefecture_name__c"],
      "reism_names": ["Order_billing_prefecture"],
      "review": "tbd_exact_field"
    },
    {
      "column": "請求先（郵便番号フル）",
      "sf_fields": ["ord.reismobj__BillingPostalCode__c", "ord.ecf_full_zip__c"],
      "review": "tbd"
    },
    {
      "column": "請求先（住所フル）",
      "sf_fields": ["ord.reismobj__BillingStreet__c"],
      "transform": "BillingStreet のみの場合は BillingCity/State と連結が必要か要確認",
      "review": "tbd"
    },
    {
      "column": "請求先（電話番号フル）",
      "sf_fields": ["ord.reismobj__BillingPhone__c", "ord.ecf_full_tel__c"],
      "review": "tbd"
    },
    {
      "column": "請求先（名前フル）",
      "sf_fields": ["ord.reismobj__BillingLastName__c", "ord.reismobj__BillingFirstName__c"],
      "transform": "concat_ws 姓+名+スペース",
      "review": "confirmed_pattern"
    },
    {
      "column": "お届け先（都道府県）",
      "sf_fields": ["ord.reismobj__ShippingState__c", "ord.ecf_shipping_prefecture_name__c"],
      "review": "tbd"
    },
    {
      "column": "お届け先（郵便番号フル）",
      "sf_fields": ["ord.reismobj__ShippingPostalCode__c", "ord.ecf_shipping_full_zip__c"],
      "review": "tbd"
    },
    {
      "column": "お届け先（住所フル）",
      "sf_fields": ["ord.reismobj__ShippingStreet__c"],
      "transform": "複数行住所は ecf_shipping_full_address__c を優先する案",
      "review": "tbd"
    },
    {
      "column": "お届け先（電話番号フル）",
      "sf_fields": ["ord.reismobj__ShippingPhone__c", "ord.ecf_shipping_full_tel__c"],
      "review": "tbd"
    },
    {
      "column": "お届け先（名前フル）",
      "sf_fields": ["ord.reismobj__ShippingLastName__c", "ord.reismobj__ShippingFirstName__c"],
      "transform": "concat_ws",
      "review": "confirmed_pattern"
    },
    {
      "column": "受注番号",
      "sf_fields": ["ord.reismobj__OrderNumber__c"],
      "reism_names": ["Order_number1"],
      "review": "confirmed_display_order_number"
    },
    {
      "column": "受注日",
      "sf_fields": ["ord.ecf_order_completed_at__c"],
      "reism_names": ["Order_order_completed_at"],
      "review": "confirmed_order_completed_at"
    },
    {
